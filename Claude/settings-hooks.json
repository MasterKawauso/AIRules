{
  "PreToolUse": [
    {
      "matcher": "Agent",
      "command": "pwsh -NoProfile -File \"<claudeHome>\\hooks\\require_agent_model.ps1\""
    },
    {
      "matcher": "Edit|Write|NotebookEdit|Bash|Agent|mcp__.*",
      "command": "pwsh -NoProfile -File \"<claudeHome>\\hooks\\workflow_gate.ps1\""
    }
  ],
  "UserPromptSubmit": [
    {
      "command": "powershell -File \"<claudeHome>\\hooks\\read_progress.ps1\""
    },
    {
      "command": "pwsh -NoProfile -File \"<claudeHome>\\hooks\\workflow_gate.ps1\""
    }
  ],
  "Stop": [
    {
      "command": "powershell -File \"<claudeHome>\\hooks\\remind_progress.ps1\""
    },
    {
      "command": "pwsh -NoProfile -File \"<claudeHome>\\hooks\\workflow_gate.ps1\""
    }
  ]
}
